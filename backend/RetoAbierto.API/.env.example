# Variables de Entorno - Backend RetoAbierto API (12-Factor App)
ASPNETCORE_ENVIRONMENT=Development
PORT=5000

# Cadena de conexión leída por DotNetEnv
ConnectionStrings__PostgresConnection="Host=localhost;Port=5432;Database=RetoAbiertoDB;Username=admin;Password=RetoAbiertoSecret123!"

# Configuración JWT
JwtSettings__Secret="RetoAbiertoSuperSecretSigningKeyForEducationalPurposes2026!"
JwtSettings__Issuer="RetoAbiertoAPI"
JwtSettings__Audience="RetoAbiertoClient"
JwtSettings__ExpiryHours=8
